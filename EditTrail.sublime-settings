// EditTrail default settings.
// Override them in Preferences > Package Settings > EditTrail > Settings.
{
	// Maximum edit locations remembered per window. Oldest are discarded first.
	"max_entries": 50,

	// Edits within this many lines of the newest location, in the same file,
	// update that location instead of adding a new one. 0 merges only edits on
	// the same line.
	//
	// It is also how close counts as "already here" when going back and
	// forward: locations within this many lines of the cursor are skipped, so
	// raising it to record fewer locations also makes each keypress jump
	// further.
	"merge_line_distance": 5,

	// Print each modification to the console (View > Show Console), saying
	// whether it added a location, merged into the newest one, or was ignored.
	// Useful when a location shows up that you did not expect.
	"debug": false,
}
